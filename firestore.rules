rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo público; la carga y edición se realizan con permisos administrativos.
    match /productos/{productoId} {
      allow read: if true;
      allow write: if false;
    }
    // La autorización depende del documento del usuario autenticado, nunca del formulario.
    function administrador() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'Administrador';
    }
    match /usuarios/{uid} {
      function propietario() {
        return request.auth != null && request.auth.uid == uid;
      }
      function perfilValido() {
        return request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.usuario is string
          && request.resource.data.usuario.size() > 0
          && request.resource.data.usuario.size() <= 200
          && request.resource.data.proveedor == request.auth.token.firebase.sign_in_provider
          && request.resource.data.ultimoAcceso == request.time;
      }
      function edicionAdministrativaValida() {
        return resource.data.uid == uid && request.resource.data.uid == uid
          && request.resource.data.usuario is string
          && request.resource.data.usuario.size() > 0
          && request.resource.data.usuario.size() <= 80
          && request.resource.data.rol in ['Invitado', 'Estudiante', 'Docente', 'Administrador']
          && (request.auth.uid != uid || request.resource.data.rol == 'Administrador')
          && request.resource.data.actualizadoEn == request.time
          && request.resource.data.actualizadoPor == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usuario', 'rol', 'actualizadoEn', 'actualizadoPor']);
      }
      allow get: if propietario() || administrador();
      allow list: if administrador();
      allow update: if administrador() && edicionAdministrativaValida();
      allow create: if propietario() && perfilValido()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'usuario', 'proveedor', 'ultimoAcceso', 'rol', 'creadoEn'])
        && request.resource.data.rol in ['Estudiante', 'Docente', 'Invitado']
        && request.resource.data.creadoEn == request.time;
      allow update: if propietario() && perfilValido()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'email', 'usuario', 'proveedor', 'ultimoAcceso']);
    }
  }
}
