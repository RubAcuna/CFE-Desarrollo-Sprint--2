rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo público; la carga y edición se realizan con permisos administrativos.
    match /productos/{productoId} {
      allow read: if true;
      function productoValido() {
        let p = request.resource.data;
        return p.keys().hasOnly(['nombre','descripcion','categoria','precio','stock','disponible','imagenes','caracteristicas','actualizadoEn','actualizadoPor','ultimaCompraId'])
          && p.nombre is string && p.nombre.size() > 0 && p.nombre.size() <= 150
          && p.descripcion is string && p.descripcion.size() > 0 && p.descripcion.size() <= 5000
          && p.categoria is string && p.categoria.size() > 0 && p.categoria.size() <= 100
          && p.precio is number && p.precio >= 0 && p.precio <= 100000000
          && p.stock is int && p.stock >= 0 && p.stock <= 100000000
          && p.disponible is bool
          && p.imagenes is list && p.imagenes.size() > 0 && p.imagenes.size() <= 50
          && p.caracteristicas is list && p.caracteristicas.size() <= 50
          && (!p.keys().hasAny(['ultimaCompraId']) || p.ultimaCompraId is string)
          && p.actualizadoEn == request.time && p.actualizadoPor == request.auth.uid;
      }
      function descuentoPorCompraValido() {
        let compra = getAfter(/databases/$(database)/documents/compras/$(request.resource.data.ultimaCompraId)).data;
        let item = compra.productos[productoId];
        return request.auth != null
          && request.resource.data.ultimaCompraId is string
          && compra.id == request.resource.data.ultimaCompraId
          && compra.usuarioId == request.auth.uid
          && compra.fecha == request.time
          && compra.estado == 'confirmada'
          && compra.productos.keys().hasAny([productoId])
          && item.id == productoId && item.cantidad is int && item.cantidad > 0 && item.cantidad <= 99
          && item.precio == resource.data.precio
          && item.subtotal == item.precio * item.cantidad
          && request.resource.data.stock == resource.data.stock - item.cantidad
          && request.resource.data.stock >= 0
          && request.resource.data.disponible == (request.resource.data.stock > 0)
          && request.resource.data.actualizadoEn == request.time
          && request.resource.data.actualizadoPor == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','disponible','ultimaCompraId','actualizadoEn','actualizadoPor']);
      }
      allow create: if administrador() && productoId.matches('[a-z0-9][a-z0-9-]{0,79}') && productoValido();
      allow update: if (administrador() && productoValido()) || descuentoPorCompraValido();
      allow delete: if administrador();
    }
    // La autorización depende del documento del usuario autenticado, nunca del formulario.
    function administrador() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'Administrador';
    }
    match /usuarios/{uid} {
      function propietario() {
        return request.auth != null && request.auth.uid == uid;
      }
      function perfilValido() {
        return request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.usuario is string
          && request.resource.data.usuario.size() > 0
          && request.resource.data.usuario.size() <= 200
          && request.resource.data.proveedor == request.auth.token.firebase.sign_in_provider
          && request.resource.data.ultimoAcceso == request.time;
      }
      function edicionAdministrativaValida() {
        return resource.data.uid == uid && request.resource.data.uid == uid
          && request.resource.data.usuario is string
          && request.resource.data.usuario.size() > 0
          && request.resource.data.usuario.size() <= 80
          && request.resource.data.rol in ['Invitado', 'Estudiante', 'Docente', 'Administrador']
          && (request.auth.uid != uid || request.resource.data.rol == 'Administrador')
          && request.resource.data.actualizadoEn == request.time
          && request.resource.data.actualizadoPor == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usuario', 'rol', 'actualizadoEn', 'actualizadoPor']);
      }
      allow get: if propietario() || administrador();
      allow list: if administrador();
      // Alta desde la sesión del administrador; Authentication asigna el UID.
      allow create: if administrador()
        && request.resource.data.keys().hasOnly(['uid','email','usuario','proveedor','ultimoAcceso','rol','creadoEn','actualizadoEn','actualizadoPor'])
        && request.resource.data.uid == uid
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.usuario is string && request.resource.data.usuario.size() > 0 && request.resource.data.usuario.size() <= 80
        && request.resource.data.rol in ['Invitado','Estudiante','Docente','Administrador']
        && request.resource.data.proveedor == 'password'
        && request.resource.data.creadoEn == request.time && request.resource.data.ultimoAcceso == request.time
        && request.resource.data.actualizadoEn == request.time && request.resource.data.actualizadoPor == request.auth.uid;
      allow delete: if administrador() && request.auth.uid != uid;
      allow update: if administrador() && edicionAdministrativaValida();
      allow create: if propietario() && perfilValido()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'usuario', 'proveedor', 'ultimoAcceso', 'rol', 'creadoEn'])
        && request.resource.data.rol in ['Estudiante', 'Docente', 'Invitado']
        && request.resource.data.creadoEn == request.time;
      allow update: if propietario() && perfilValido()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'email', 'usuario', 'proveedor', 'ultimoAcceso']);
    }
    // Cada compra pertenece al usuario autenticado y se crea junto con el descuento de stock.
    match /compras/{compraId} {
      function compraValida() {
        let c = request.resource.data;
        return request.auth != null
          && c.keys().hasOnly(['id','usuarioId','usuarioEmail','fecha','estado','moneda','medioPago','productos','total','facturacion','datosEnvio'])
          && c.id == compraId && c.usuarioId == request.auth.uid
          && c.usuarioEmail == request.auth.token.email
          && c.fecha == request.time && c.estado == 'confirmada' && c.moneda == 'UYU'
          && c.medioPago in ['eBROU','Mercado Pago']
          && c.productos is map && c.productos.size() > 0 && c.productos.size() <= 20
          && c.total is number && c.total >= 0
          && c.facturacion is map && c.datosEnvio is map
          && c.facturacion.keys().hasOnly(['nombreCompleto','rut'])
          && c.datosEnvio.keys().hasOnly(['nombreCompleto','departamento','ciudad','direccion','telefono','rut'])
          && c.datosEnvio.nombreCompleto is string && c.datosEnvio.nombreCompleto.size() > 0 && c.datosEnvio.nombreCompleto.size() <= 120
          && c.datosEnvio.departamento is string && c.datosEnvio.departamento.size() > 0 && c.datosEnvio.departamento.size() <= 80
          && c.datosEnvio.ciudad is string && c.datosEnvio.ciudad.size() > 0 && c.datosEnvio.ciudad.size() <= 80
          && c.datosEnvio.direccion is string && c.datosEnvio.direccion.size() > 0 && c.datosEnvio.direccion.size() <= 200
          && c.datosEnvio.telefono is string && c.datosEnvio.telefono.size() > 0 && c.datosEnvio.telefono.size() <= 30
          && c.datosEnvio.rut is string && c.datosEnvio.rut.size() <= 20
          && c.facturacion.nombreCompleto == c.datosEnvio.nombreCompleto
          && c.facturacion.rut == c.datosEnvio.rut;
      }
      allow create: if compraValida();
      allow get: if request.auth != null && (resource.data.usuarioId == request.auth.uid || administrador());
      // La consulta del cliente incluye where('usuarioId', '==', request.auth.uid).
      allow list: if request.auth != null && (administrador() || resource.data.usuarioId == request.auth.uid);
      allow update, delete: if false;
    }
    // Reseñas públicas; existe como máximo un documento por usuario y producto.
    match /comentarios/{comentarioId} {
      function comentarioBaseValido() {
        let c = request.resource.data;
        let perfil = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
        return request.auth != null
          && c.keys().hasOnly(['id','productoId','usuarioId','usuarioNombre','calificacion','texto','creadoEn','actualizadoEn'])
          && c.id == comentarioId && c.usuarioId == request.auth.uid
          && comentarioId == c.productoId + '_' + request.auth.uid
          && c.productoId is string && c.productoId.matches('[a-z0-9][a-z0-9-]{0,79}')
          && exists(/databases/$(database)/documents/productos/$(c.productoId))
          && c.usuarioNombre is string && c.usuarioNombre == perfil.usuario
          && c.usuarioNombre.size() > 0 && c.usuarioNombre.size() <= 80
          && c.calificacion is int && c.calificacion >= 1 && c.calificacion <= 5
          && c.texto is string && c.texto.size() >= 3 && c.texto.size() <= 1000
          && c.actualizadoEn == request.time;
      }
      allow read: if true;
      allow create: if comentarioBaseValido() && request.resource.data.creadoEn == request.time;
      allow update: if resource.data.usuarioId == request.auth.uid
        && comentarioBaseValido()
        && request.resource.data.creadoEn == resource.data.creadoEn
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usuarioNombre','calificacion','texto','actualizadoEn']);
      allow delete: if request.auth != null && resource.data.usuarioId == request.auth.uid;
    }
    // Métricas anónimas del sitio. Cada documento representa una vista y no contiene
    // identificadores personales; solo los administradores pueden consultar el conjunto.
    match /vistas/{vistaId} {
      allow create: if request.resource.data.keys().hasOnly(['pagina','fecha','creadoEn'])
        && request.resource.data.pagina is string
        && request.resource.data.pagina.matches('[a-z0-9-]{1,40}')
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.creadoEn == request.time;
      allow read: if administrador();
      allow update, delete: if false;
    }
  }
}
